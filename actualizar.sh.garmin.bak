#!/bin/bash
set -Eeuo pipefail

REPO="$HOME/git/running_page"
DOWNLOAD_SCRIPT="$HOME/git/python-garminconnect/descargar_todo.py"

DOWNLOAD_PYTHON="$HOME/git/python-garminconnect/.venv/bin/python"
PAGE_PYTHON="$REPO/.venv/bin/python"

TOKEN_FILE="$HOME/git/garmin-grafana/garminconnect-tokens/garmin_tokens.json"

LOG_DIR="$REPO/logs"
LOG_FILE="$LOG_DIR/update.log"

EXPORT_GPX="$HOME/garmin_export/gpx"
EXPORT_FIT="$HOME/garmin_export/fit"

mkdir -p "$LOG_DIR" "$EXPORT_GPX" "$EXPORT_FIT"
exec >> "$LOG_FILE" 2>&1

echo
echo "=========================================="
echo "$(date '+%Y-%m-%d %H:%M:%S')"
echo "Actualización running_page"
echo "=========================================="

cd "$REPO"

# Evitar ejecuciones simultáneas
exec 9>"$REPO/.update.lock"
flock -n 9 || {
    echo "Ya hay otra actualización ejecutándose."
    exit 0
}

# Comprobar dependencias
for FILE in "$DOWNLOAD_SCRIPT" "$TOKEN_FILE"; do
    [[ -f "$FILE" ]] || {
        echo "ERROR: no existe $FILE"
        exit 1
    }
done

for PYTHON in "$DOWNLOAD_PYTHON" "$PAGE_PYTHON"; do
    [[ -x "$PYTHON" ]] || {
        echo "ERROR: no existe el Python $PYTHON"
        exit 1
    }
done

# 1. Descargar actividades recientes
START_DATE=$(date -d "1 days ago" +%Y-%m-%d)
END_DATE=$(date +%Y-%m-%d)

echo
echo "1. Descargando actividades Garmin"
echo "Desde: $START_DATE"
echo "Hasta: $END_DATE"

"$DOWNLOAD_PYTHON" "$DOWNLOAD_SCRIPT" \
    --tokens "$TOKEN_FILE" \
    --start "$START_DATE" \
    --end "$END_DATE" \
    --output "$REPO"

# 2. Procesar únicamente GPX pendientes
echo
echo "2. Sincronizando GPX con running_page"

"$PAGE_PYTHON" run_page/gpx_sync.py

# 3. Exportar copias sin sacar los originales
echo
echo "3. Actualizando copias FIT y GPX"

find GPX_OUT -maxdepth 1 -type f -iname '*.gpx' \
    -exec cp -u -t "$EXPORT_GPX" -- {} +

find FIT_OUT -maxdepth 1 -type f -iname '*.fit' \
    -exec cp -u -t "$EXPORT_FIT" -- {} +

# 4. Publicar JSON si ha cambiado
echo
echo "4. Comprobando cambios en activities.json"

git add src/static/activities.json

if git diff --cached --quiet -- src/static/activities.json; then
    echo "No hay cambios en activities.json."
else
    echo "Hay cambios. Creando commit..."
    git commit -m "Update Garmin activities" -- src/static/activities.json

    echo "Subiendo cambios a GitHub..."
    git push origin main
fi

echo
echo "=========================================="
echo "$(date '+%Y-%m-%d %H:%M:%S')"
echo "Actualización completada correctamente."
echo "=========================================="
